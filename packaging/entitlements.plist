<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rights of Orchestra.app under the hardened runtime (required for notarization with a
     Developer ID). Orchestra drives other apps through AppleScript (osascript: picking a
     folder, the clipboard, a window's screenshot through System Events): that needs the
     Apple Events right. Nothing else: no sandbox, no JIT, no unsigned libraries. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
